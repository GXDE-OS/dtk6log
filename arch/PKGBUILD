pkgname=dtk6log-git
pkgver=0.0.6
pkgrel=1
pkgdesc='DTK6 log modules'
arch=('x86_64' 'aarch64')
url="https://github.com/GXDE-OS/dtk6log"
license=('LGPL-2.1-or-later')
depends=('qt6-base' 'spdlog' 'fmt' 'systemd-libs' 'libgcc' 'libstdc++' 'glibc')
makedepends=('git' 'cmake' 'ninja')
provides=("dtk6log=$pkgver")
conflicts=('dtk6log')
groups=('deepin-git')
source=()
sha512sums=()

# 直接使用 PKGBUILD 所在的 git 仓库作为源码 ・ Build from the git checkout this PKGBUILD lives in.
_srcroot() {
  git -C "$startdir" rev-parse --show-toplevel
}

build() {
  cmake -B build -S "$(_srcroot)" -GNinja \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_LIBDIR=lib \
    -DCMAKE_INSTALL_LIBEXECDIR=lib \
    -DMKSPECS_INSTALL_DIR=lib/qt6/mkspecs/modules \
    -DBUILD_WITH_QT6=ON \
    -DBUILD_WITH_SYSTEMD=ON
  ninja -C build
}

package() {
  DESTDIR="$pkgdir" ninja -C build install
}
